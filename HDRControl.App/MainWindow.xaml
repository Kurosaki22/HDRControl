<Window
    x:Class="HDRControl.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:HDRControl.App.Controls"
    xmlns:services="clr-namespace:HDRControl.App.Services"
    Title="HDR Control"
    Width="920"
    Height="680"
    WindowStartupLocation="CenterScreen"
    FontFamily="{StaticResource UiFont}"
    Background="{DynamicResource DashboardBackgroundBrush}"
    Closing="Window_Closing">
    <Grid>
        <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top bar: logo, the two pages, and the all-displays switch. -->
            <Border
                BorderBrush="{DynamicResource DashboardCardBorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock
                            Style="{StaticResource IconStyle}"
                            Text="&#xE7F4;"
                            FontSize="18"
                            Foreground="{DynamicResource DashboardAccentBrush}" />
                        <TextBlock Text="HDR Control" Style="{StaticResource TitleTextStyle}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Margin="24,0,0,0"
                        Style="{StaticResource DisplaysTabStyle}"
                        Content="Displays"
                        Click="DisplaysNavigation_Click"
                        AutomationProperties.Name="Displays" />
                    <Button
                        Grid.Column="2"
                        Margin="18,0,0,0"
                        Style="{StaticResource SettingsTabStyle}"
                        Content="Settings"
                        Click="SettingsNavigation_Click"
                        AutomationProperties.Name="Settings" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding DisplaysPageVisibility}">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="All displays" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource DashboardTextBrush}" />
                                <TextBlock Text="{Binding AllDisplaysStatusLabel}" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource DashboardMutedBrush}" />
                            </StackPanel>
                            <TextBox
                                Style="{StaticResource HotkeyBoxStyle}"
                                Text="{Binding AllDisplaysHotkeyDisplayText, Mode=OneWay}"
                                Tag="all-displays"
                                GotKeyboardFocus="HotkeyTextBox_GotFocus"
                                LostKeyboardFocus="HotkeyTextBox_LostFocus"
                                PreviewKeyDown="HotkeyTextBox_KeyDown"
                                AutomationProperties.Name="All displays hotkey" />
                            <controls:HdrPillToggle
                                Margin="12,0,0,0"
                                IsChecked="{Binding IsAllDisplaysHdrEnabled, Mode=OneWay}"
                                IsEnabled="{Binding CanToggleAllDisplays}"
                                Toggled="AllDisplaysHdrToggle_Toggled"
                                AutomationProperties.Name="Toggle HDR for all displays" />
                        </StackPanel>
                        <Button
                            Margin="14,0,0,0"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Visibility="{Binding RefreshButtonVisibility}"
                            ToolTip="Refresh display list"
                            AutomationProperties.Name="Refresh display list">
                            <TextBlock Style="{StaticResource IconStyle}" Text="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,22,0,18">
                    <TextBlock
                        Text="{Binding CurrentPageTitle}"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource DashboardTextBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock
                            Text="{Binding CurrentPageSubtitle}"
                            FontSize="12"
                            Foreground="{DynamicResource DashboardMutedBrush}" />
                        <TextBlock
                            Text="{Binding HdrCapableCountLabel}"
                            Visibility="{Binding DisplaysPageVisibility}"
                            FontSize="12"
                            Margin="8,0,0,0"
                            Foreground="{DynamicResource DashboardMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Visibility="{Binding DisplaysPageVisibility}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,5">
                            <ItemsControl
                                ItemsSource="{Binding Monitors}"
                                IsEnabled="{Binding CanSelectMonitors}"
                                Visibility="{Binding MonitorListVisibility}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="190" Margin="0,0,18,22">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanSelect}" Value="False">
                                                            <Setter Property="Opacity" Value="0.5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <!-- The display as a monitor: the state is the picture. -->
                                            <Border Height="107" CornerRadius="6" BorderThickness="5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource DashboardCardBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DashboardBezelBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHdrEnabled}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource DashboardAccentFillBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource DashboardAccentFillBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="n/a" />
                                                                <Setter Property="Foreground" Value="{DynamicResource DashboardMutedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanSelect}" Value="True">
                                                                        <Setter Property="Text" Value="SDR" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource DashboardTextBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsHdrEnabled}" Value="True">
                                                                        <Setter Property="Text" Value="HDR" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource DashboardOnAccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock
                                                        Text="{Binding StatusDetail}"
                                                        FontSize="11"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Center"
                                                        TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource DashboardMutedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHdrEnabled}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DashboardOnAccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <Border Width="26" Height="8" Background="{DynamicResource DashboardBezelBrush}" HorizontalAlignment="Center" />
                                            <Border Width="70" Height="4" CornerRadius="2" Background="{DynamicResource DashboardBezelBrush}" HorizontalAlignment="Center" />

                                            <TextBlock
                                                Text="{Binding Name}"
                                                Style="{StaticResource TitleTextStyle}"
                                                TextTrimming="CharacterEllipsis"
                                                Margin="0,12,0,8" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    Style="{StaticResource HotkeyBoxStyle}"
                                                    IsEnabled="{Binding CanSelect, Mode=OneWay}"
                                                    Text="{Binding HotkeyDisplayText, Mode=OneWay}"
                                                    GotKeyboardFocus="HotkeyTextBox_GotFocus"
                                                    LostKeyboardFocus="HotkeyTextBox_LostFocus"
                                                    PreviewKeyDown="HotkeyTextBox_KeyDown"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='{}{0} hotkey'}" />
                                                <controls:HdrPillToggle
                                                    Grid.Column="2"
                                                    IsChecked="{Binding IsHdrEnabled, Mode=OneWay}"
                                                    IsEnabled="{Binding CanSelect, Mode=OneWay}"
                                                    Toggled="MonitorHdrToggle_Toggled"
                                                    AutomationProperties.Name="{Binding Name}"
                                                    AutomationProperties.HelpText="{Binding StatusLabel}" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding EmptyStateVisibility}">
                                <ProgressBar
                                    Width="80"
                                    Margin="0,0,0,6"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsRefreshing, Converter={StaticResource VisibleWhenTrue}}" />
                                <TextBlock
                                    Style="{StaticResource IconStyle}"
                                    Text="&#xE7F4;"
                                    FontSize="20"
                                    Foreground="{DynamicResource DashboardMutedBrush}"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    Text="No active displays found"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource DashboardTextBrush}" />
                                <TextBlock
                                    Text="Connect a display, then refresh."
                                    FontSize="11"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource DashboardMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="1" Visibility="{Binding SettingsPageVisibility}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,5" MaxWidth="560" HorizontalAlignment="Left">
                            <Border Style="{StaticResource RowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="Dark mode" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock Text="Switch between a light and a dark look." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource IconButtonStyle}"
                                        Click="ThemeToggle_Click"
                                        ToolTip="{Binding ThemeToggleName}"
                                        AutomationProperties.Name="{Binding ThemeToggleName}">
                                        <TextBlock Style="{StaticResource IconStyle}" Text="{Binding ThemeGlyph}" FontSize="15" HorizontalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource RowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="Keep in the system tray" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock Text="Closing the window sends the app to the tray." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox
                                        Grid.Column="1"
                                        IsChecked="{Binding KeepInSystemTrayOnClose, Mode=OneWay}"
                                        MinWidth="0"
                                        Checked="TrayOption_Changed"
                                        Unchecked="TrayOption_Changed"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Keep in the system tray when closing" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource RowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="Start with Windows" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock Text="Launch HDR Control when you sign in to Windows." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox
                                        Grid.Column="1"
                                        IsChecked="{Binding StartWithWindows, Mode=OneWay}"
                                        IsEnabled="{Binding CanConfigureAutoStart}"
                                        MinWidth="0"
                                        Checked="AutoStartOption_Changed"
                                        Unchecked="AutoStartOption_Changed"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Start HDR Control with Windows" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource RowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="Start minimized in the system tray" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock Text="Stay hidden when Windows starts the app." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox
                                        Grid.Column="1"
                                        IsChecked="{Binding StartMinimizedToTray, Mode=OneWay}"
                                        IsEnabled="{Binding CanConfigureStartMinimized}"
                                        MinWidth="0"
                                        Checked="StartMinimizedOption_Changed"
                                        Unchecked="StartMinimizedOption_Changed"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Start minimized in the system tray when Windows starts HDR Control" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource RowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="Reset hotkeys" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock Text="Restore the default hotkey for every display." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Content="Reset"
                                        Click="ResetHotkeys_Click"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Reset all hotkeys" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource RowStyle}" BorderThickness="0,1,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="Exception log" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock
                                            Text="Errors and crashes are written to ExceptionLog.txt in the Logs folder. Attach it when you report a problem."
                                            Style="{StaticResource MutedTextStyle}"
                                            Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Content="Open folder"
                                        Click="OpenLogFolder_Click"
                                        VerticalAlignment="Center"
                                        ToolTip="{x:Static services:ExceptionLog.LogDirectory}"
                                        AutomationProperties.Name="Open exception log folder" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border
                Grid.Row="2"
                Padding="20,8"
                BorderBrush="{DynamicResource DashboardCardBorderBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DetectedMonitorCountLabel}" FontSize="11" Foreground="{DynamicResource DashboardMutedBrush}" />
                    <TextBlock Text="{Binding LastUpdatedText}" FontSize="11" Margin="16,0,0,0" Foreground="{DynamicResource DashboardMutedBrush}" />
                    <TextBlock Text="{Binding AppVersionLabel, Mode=OneTime}" FontSize="11" Margin="16,0,0,0" Foreground="{DynamicResource DashboardMutedBrush}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Row="1"
                Grid.RowSpan="2"
                Visibility="{Binding NotificationVisibility}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                MaxWidth="420"
                Margin="0,0,0,48"
                Padding="14,10,8,10"
                CornerRadius="8"
                Background="{DynamicResource DashboardToastBrush}"
                BorderBrush="{DynamicResource DashboardCardBorderBrush}"
                BorderThickness="1"
                AutomationProperties.LiveSetting="Polite">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource IconStyle}"
                        Text="{Binding NotificationGlyph}"
                        FontSize="16"
                        Foreground="{Binding NotificationIconBrush}"
                        VerticalAlignment="Top"
                        Margin="0,2,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding NotificationTitle}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource DashboardTextBrush}" />
                        <TextBlock
                            Text="{Binding NotificationMessage}"
                            FontSize="12"
                            Margin="0,1,0,0"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource DashboardMutedBrush}" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Click="NotificationClose_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6"
                        Margin="10,0,0,0"
                        MinWidth="0"
                        MinHeight="0"
                        VerticalAlignment="Top"
                        ToolTip="Dismiss"
                        AutomationProperties.Name="Dismiss notification">
                        <TextBlock Style="{StaticResource IconStyle}" Text="&#xE711;" FontSize="10" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- In-window dialog; WPF has no dialog with freely named buttons. -->
        <Grid x:Name="DialogOverlay" Visibility="Collapsed" Background="{DynamicResource DashboardOverlayBrush}">
            <Border
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24,20"
                CornerRadius="8"
                Background="{DynamicResource DashboardToastBrush}"
                BorderBrush="{DynamicResource DashboardCardBorderBrush}"
                BorderThickness="1"
                KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Cycle">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource DashboardTextBrush}" />
                    <TextBlock x:Name="DialogMessage" Margin="0,10,0,20" Style="{StaticResource MutedTextStyle}" FontSize="13" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DialogPrimaryButton" Click="DialogButton_Click" Margin="0,0,8,0" MinWidth="90" />
                        <Button x:Name="DialogSecondaryButton" Click="DialogButton_Click" Margin="0,0,8,0" MinWidth="90" />
                        <Button x:Name="DialogCloseButton" Click="DialogButton_Click" MinWidth="90" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
