<Window
    x:Class="HDRControl.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HDRControl.App.Controls"
    Title="HDR Control">
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource DashboardBackgroundBrush}"
        RequestedTheme="Light"
        Loaded="RootGrid_Loaded">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="204" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Margin="14,14,7,14"
            Padding="15"
            CornerRadius="20"
            Background="{ThemeResource DashboardSidebarBrush}"
            BorderBrush="{ThemeResource DashboardGlassBorderBrush}"
            BorderThickness="1">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,3,4,20">
                    <Border
                        Width="30"
                        Height="30"
                        CornerRadius="10"
                        Background="{ThemeResource DashboardCardBrush}">
                        <FontIcon
                            Glyph="&#xE7F4;"
                            FontSize="15"
                            Foreground="{ThemeResource DashboardAccentBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock
                            Text="HDR Control"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock
                            Text="Display controls"
                            FontSize="10"
                            Foreground="{ThemeResource DashboardMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="7">
                    <Grid Height="42">
                        <Border
                            CornerRadius="9"
                            Background="{ThemeResource DashboardNavigationSelectedBrush}"
                            Visibility="{x:Bind ViewModel.DisplaysPageVisibility, Mode=OneWay}" />
                        <Button
                            Click="DisplaysNavigation_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,7"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="Displays">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <FontIcon
                                    Glyph="&#xE7F4;"
                                    FontSize="16"
                                    Foreground="{x:Bind ViewModel.DisplaysNavigationForeground, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="Displays"
                                    FontSize="13"
                                    VerticalAlignment="Center"
                                    Foreground="{x:Bind ViewModel.DisplaysNavigationForeground, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Height="42">
                        <Border
                            CornerRadius="9"
                            Background="{ThemeResource DashboardNavigationSelectedBrush}"
                            Visibility="{x:Bind ViewModel.SettingsPageVisibility, Mode=OneWay}" />
                        <Button
                            Click="SettingsNavigation_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,7"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="Settings">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <FontIcon
                                    Glyph="&#xE713;"
                                    FontSize="16"
                                    Foreground="{x:Bind ViewModel.SettingsNavigationForeground, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="Settings"
                                    FontSize="13"
                                    VerticalAlignment="Center"
                                    Foreground="{x:Bind ViewModel.SettingsNavigationForeground, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="2" Margin="5,8,4,2">
                    <TextBlock
                        Text="{x:Bind ViewModel.DetectedMonitorCountLabel, Mode=OneWay}"
                        FontSize="11"
                        Foreground="{ThemeResource DashboardMutedBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.LastUpdatedText, Mode=OneWay}"
                        FontSize="10"
                        Foreground="{ThemeResource DashboardMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid
            Grid.Column="1"
            Margin="15,14,18,14"
            RowDefinitions="Auto,*">
            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto"
                Margin="7,5,7,17">
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind ViewModel.CurrentPageTitle, Mode=OneWay}"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.CurrentPageSubtitle, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource DashboardMutedBrush}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Visibility="{x:Bind ViewModel.RefreshButtonVisibility, Mode=OneWay}"
                    ToolTipService.ToolTip="Refresh display list"
                    AutomationProperties.Name="Refresh display list"
                    Padding="11,8"
                    MinHeight="36">
                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto,*">
                <InfoBar
                    Grid.Row="0"
                    IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.NotificationSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.NotificationTitle, Mode=OneWay}"
                    Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
                    IsClosable="True"
                    Closed="Notification_Closed"
                    Margin="0,0,0,7" />

                <Grid Grid.Row="1">
                    <Grid
                        Visibility="{x:Bind ViewModel.DisplaysPageVisibility, Mode=OneWay}"
                        RowDefinitions="Auto,Auto,*">
                        <Grid ColumnDefinitions="*,Auto" Margin="5,0,5,12">
                            <TextBlock
                                Text="HDR control"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource DashboardMutedBrush}"
                                VerticalAlignment="Center" />
                            <Border
                                Grid.Column="1"
                                Padding="8,4"
                                CornerRadius="10"
                                Background="{ThemeResource DashboardAccentSoftBrush}"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind ViewModel.HdrCapableCountLabel, Mode=OneWay}"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource DashboardAccentBrush}" />
                            </Border>
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Padding="14,8"
                            Margin="0,0,2,8"
                            CornerRadius="12"
                            Background="{ThemeResource DashboardCardBrush}"
                            BorderBrush="{ThemeResource DashboardCardBorderBrush}"
                            BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                <FontIcon
                                    Glyph="&#xE8D4;"
                                    FontSize="16"
                                    Foreground="{ThemeResource DashboardAccentBrush}"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="All displays"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.AllDisplaysStatusLabel, Mode=OneWay}"
                                        FontSize="11"
                                        Foreground="{ThemeResource DashboardMutedBrush}" />
                                </StackPanel>
                                <TextBox
                                    Grid.Column="2"
                                    Style="{StaticResource ShortcutBoxStyle}"
                                    IsReadOnly="True"
                                    Text="{x:Bind ViewModel.AllDisplaysHotkeyDisplayText, Mode=OneWay}"
                                    PlaceholderText="Set shortcut"
                                    Tag="all-displays"
                                    GotFocus="HotkeyTextBox_GotFocus"
                                    LostFocus="HotkeyTextBox_LostFocus"
                                    KeyDown="HotkeyTextBox_KeyDown"
                                    ToolTipService.ToolTip="Click, then press a modifier and a key" />
                                <controls:HdrPillToggle
                                    Grid.Column="3"
                                    IsOn="{x:Bind ViewModel.IsAllDisplaysHdrEnabled, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanToggleAllDisplays, Mode=OneWay}"
                                    Toggled="AllDisplaysHdrToggle_Toggled"
                                    AutomationProperties.Name="Toggle HDR for all displays"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ScrollViewer
                            Grid.Row="2"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="7" Padding="0,0,2,5">
                                <ItemsControl
                                    ItemsSource="{x:Bind ViewModel.Monitors, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanSelectMonitors, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.MonitorListVisibility, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="14,8"
                                                Margin="0,0,0,6"
                                                CornerRadius="12"
                                                Background="{ThemeResource DashboardCardBrush}"
                                                BorderBrush="{ThemeResource DashboardGlassBorderBrush}"
                                                BorderThickness="1">
                                                <Grid
                                                    ColumnDefinitions="Auto,*,Auto,Auto"
                                                    ColumnSpacing="12">
                                                    <FontIcon
                                                        Glyph="&#xE7F4;"
                                                        FontSize="16"
                                                        Foreground="{ThemeResource DashboardAccentBrush}"
                                                        VerticalAlignment="Center" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Spacing="0"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{Binding Name}"
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            TextTrimming="CharacterEllipsis"
                                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock
                                                            Text="{Binding StatusDetail}"
                                                            FontSize="11"
                                                            TextTrimming="CharacterEllipsis"
                                                            Foreground="{ThemeResource DashboardMutedBrush}" />
                                                    </StackPanel>
                                                    <TextBox
                                                        Grid.Column="2"
                                                        Style="{StaticResource ShortcutBoxStyle}"
                                                        IsReadOnly="True"
                                                        IsEnabled="{Binding CanSelect}"
                                                        Text="{Binding HotkeyDisplayText, Mode=OneWay}"
                                                        PlaceholderText="Set shortcut"
                                                        GotFocus="HotkeyTextBox_GotFocus"
                                                        LostFocus="HotkeyTextBox_LostFocus"
                                                        KeyDown="HotkeyTextBox_KeyDown"
                                                        ToolTipService.ToolTip="Click, then press a modifier and a key" />
                                                    <controls:HdrPillToggle
                                                        Grid.Column="3"
                                                        IsOn="{Binding IsHdrEnabled, Mode=OneWay}"
                                                        IsEnabled="{Binding CanSelect}"
                                                        Toggled="MonitorHdrToggle_Toggled"
                                                        AutomationProperties.Name="{Binding Name}"
                                                        AutomationProperties.HelpText="{Binding StatusLabel}"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel
                                    Spacing="6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                                    <ProgressRing
                                        Width="22"
                                        Height="22"
                                        IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                                        HorizontalAlignment="Center" />
                                    <FontIcon
                                        Glyph="&#xE7F4;"
                                        FontSize="20"
                                        Foreground="{ThemeResource DashboardMutedBrush}"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        Text="No active displays found"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock
                                        Text="Connect a display, then refresh."
                                        FontSize="11"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource DashboardMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid
                        Visibility="{x:Bind ViewModel.SettingsPageVisibility, Mode=OneWay}"
                        RowDefinitions="Auto,*">
                        <TextBlock
                            Text="General"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="5,0,5,12"
                            Foreground="{ThemeResource DashboardMutedBrush}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8" Padding="0,0,2,5">
                            <Border
                                Padding="14,8"
                                CornerRadius="12"
                                Background="{ThemeResource DashboardCardBrush}"
                                BorderBrush="{ThemeResource DashboardGlassBorderBrush}"
                                BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="15">
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="Keep in the system tray"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock
                                            Text="When enabled, closing the window sends the app directly to the tray."
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            Foreground="{ThemeResource DashboardMutedBrush}" />
                                    </StackPanel>
                                    <CheckBox
                                        Grid.Column="1"
                                        IsChecked="{x:Bind ViewModel.KeepInSystemTrayOnClose, Mode=OneWay}"
                                        MinWidth="0"
                                        Checked="TrayOption_Changed"
                                        Unchecked="TrayOption_Changed"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Keep in the system tray when closing" />
                                </Grid>
                            </Border>

                            <Border
                                Padding="14,8"
                                CornerRadius="12"
                                Background="{ThemeResource DashboardCardBrush}"
                                BorderBrush="{ThemeResource DashboardGlassBorderBrush}"
                                BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="15">
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="Start with Windows"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock
                                            Text="Launch HDR Control automatically when you sign in to Windows."
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            Foreground="{ThemeResource DashboardMutedBrush}" />
                                    </StackPanel>
                                    <CheckBox
                                        Grid.Column="1"
                                        IsChecked="{x:Bind ViewModel.StartWithWindows, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanConfigureAutoStart, Mode=OneWay}"
                                        MinWidth="0"
                                        Checked="AutoStartOption_Changed"
                                        Unchecked="AutoStartOption_Changed"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Start HDR Control with Windows" />
                                </Grid>
                            </Border>

                            <Border
                                Padding="14,8"
                                CornerRadius="12"
                                Background="{ThemeResource DashboardCardBrush}"
                                BorderBrush="{ThemeResource DashboardGlassBorderBrush}"
                                BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="15">
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="Start minimized in the system tray"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock
                                            Text="When Windows starts HDR Control automatically, keep the window hidden."
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            Foreground="{ThemeResource DashboardMutedBrush}" />
                                    </StackPanel>
                                    <CheckBox
                                        Grid.Column="1"
                                        IsChecked="{x:Bind ViewModel.StartMinimizedToTray, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanConfigureStartMinimized, Mode=OneWay}"
                                        MinWidth="0"
                                        Checked="StartMinimizedOption_Changed"
                                        Unchecked="StartMinimizedOption_Changed"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Start minimized in the system tray when Windows starts HDR Control" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
