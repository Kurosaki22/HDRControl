<Window
    x:Class="HDRControl.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:HDRControl.App.Controls"
    xmlns:services="clr-namespace:HDRControl.App.Services"
    Title="HDR Control"
    Width="920"
    Height="680"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource DashboardBackgroundBrush}"
    Closing="Window_Closing">
    <Grid>
        <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="204" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="14,14,7,14"
                Padding="15"
                CornerRadius="20"
                Background="{DynamicResource DashboardSidebarBrush}"
                BorderBrush="{DynamicResource DashboardGlassBorderBrush}"
                BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="4,3,4,20">
                        <Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource DashboardCardBrush}">
                            <TextBlock
                                Style="{StaticResource IconStyle}"
                                Text="&#xE7F4;"
                                FontSize="15"
                                Foreground="{DynamicResource DashboardAccentBrush}"
                                HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="HDR Control" Style="{StaticResource TitleTextStyle}" />
                            <TextBlock Text="Display controls" FontSize="10" Foreground="{DynamicResource DashboardMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Grid Height="42" Margin="0,0,0,7">
                            <Border
                                CornerRadius="9"
                                Background="{DynamicResource DashboardNavigationSelectedBrush}"
                                Visibility="{Binding DisplaysPageVisibility}" />
                            <Button
                                Style="{StaticResource NavigationButtonStyle}"
                                Click="DisplaysNavigation_Click"
                                AutomationProperties.Name="Displays">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Style="{StaticResource DisplaysNavigationTextStyle}"
                                        FontFamily="{StaticResource IconFont}"
                                        Text="&#xE7F4;"
                                        FontSize="16" />
                                    <TextBlock
                                        Style="{StaticResource DisplaysNavigationTextStyle}"
                                        Text="Displays"
                                        FontSize="13"
                                        Margin="9,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Height="42">
                            <Border
                                CornerRadius="9"
                                Background="{DynamicResource DashboardNavigationSelectedBrush}"
                                Visibility="{Binding SettingsPageVisibility}" />
                            <Button
                                Style="{StaticResource NavigationButtonStyle}"
                                Click="SettingsNavigation_Click"
                                AutomationProperties.Name="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Style="{StaticResource SettingsNavigationTextStyle}"
                                        FontFamily="{StaticResource IconFont}"
                                        Text="&#xE713;"
                                        FontSize="16" />
                                    <TextBlock
                                        Style="{StaticResource SettingsNavigationTextStyle}"
                                        Text="Settings"
                                        FontSize="13"
                                        Margin="9,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="5,8,4,2">
                        <TextBlock Text="{Binding DetectedMonitorCountLabel}" FontSize="11" Foreground="{DynamicResource DashboardMutedBrush}" />
                        <TextBlock Text="{Binding LastUpdatedText}" FontSize="10" Margin="0,2,0,0" Foreground="{DynamicResource DashboardMutedBrush}" />
                        <TextBlock Text="{Binding AppVersionLabel, Mode=OneTime}" FontSize="10" Margin="0,2,0,0" Foreground="{DynamicResource DashboardMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="15,14,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="7,5,7,17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding CurrentPageTitle}"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource DashboardTextBrush}" />
                        <TextBlock
                            Text="{Binding CurrentPageSubtitle}"
                            FontSize="12"
                            Margin="0,1,0,0"
                            Foreground="{DynamicResource DashboardMutedBrush}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Command="{Binding RefreshCommand}"
                        Visibility="{Binding RefreshButtonVisibility}"
                        ToolTip="Refresh display list"
                        AutomationProperties.Name="Refresh display list"
                        Padding="11,8"
                        MinHeight="36">
                        <TextBlock Style="{StaticResource IconStyle}" Text="&#xE72C;" FontSize="15" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Visibility="{Binding DisplaysPageVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="5,0,5,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="HDR control"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource DashboardMutedBrush}"
                            VerticalAlignment="Center" />
                        <Border
                            Grid.Column="1"
                            Padding="8,4"
                            CornerRadius="10"
                            Background="{DynamicResource DashboardAccentSoftBrush}"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding HdrCapableCountLabel}"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource DashboardAccentBrush}" />
                        </Border>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Style="{StaticResource CardStyle}"
                        BorderBrush="{DynamicResource DashboardCardBorderBrush}"
                        Margin="0,0,2,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Style="{StaticResource IconStyle}"
                                Text="&#xE8D4;"
                                FontSize="16"
                                Foreground="{DynamicResource DashboardAccentBrush}" />
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="All displays" Style="{StaticResource TitleTextStyle}" />
                                <TextBlock Text="{Binding AllDisplaysStatusLabel}" FontSize="11" Foreground="{DynamicResource DashboardMutedBrush}" />
                            </StackPanel>
                            <TextBox
                                Grid.Column="2"
                                Style="{StaticResource HotkeyBoxStyle}"
                                Text="{Binding AllDisplaysHotkeyDisplayText, Mode=OneWay}"
                                Tag="all-displays"
                                GotKeyboardFocus="HotkeyTextBox_GotFocus"
                                LostKeyboardFocus="HotkeyTextBox_LostFocus"
                                PreviewKeyDown="HotkeyTextBox_KeyDown"
                                AutomationProperties.Name="All displays hotkey" />
                            <controls:HdrPillToggle
                                Grid.Column="3"
                                Margin="12,0,0,0"
                                IsChecked="{Binding IsAllDisplaysHdrEnabled, Mode=OneWay}"
                                IsEnabled="{Binding CanToggleAllDisplays}"
                                Toggled="AllDisplaysHdrToggle_Toggled"
                                AutomationProperties.Name="Toggle HDR for all displays" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,2,5">
                            <ItemsControl
                                ItemsSource="{Binding Monitors}"
                                IsEnabled="{Binding CanSelectMonitors}"
                                Visibility="{Binding MonitorListVisibility}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Style="{StaticResource IconStyle}"
                                                    Text="&#xE7F4;"
                                                    FontSize="16"
                                                    Foreground="{DynamicResource DashboardAccentBrush}" />
                                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        Style="{StaticResource TitleTextStyle}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Text="{Binding StatusDetail}"
                                                        FontSize="11"
                                                        TextTrimming="CharacterEllipsis"
                                                        Foreground="{DynamicResource DashboardMutedBrush}" />
                                                </StackPanel>
                                                <TextBox
                                                    Grid.Column="2"
                                                    Style="{StaticResource HotkeyBoxStyle}"
                                                    IsEnabled="{Binding CanSelect, Mode=OneWay}"
                                                    Text="{Binding HotkeyDisplayText, Mode=OneWay}"
                                                    GotKeyboardFocus="HotkeyTextBox_GotFocus"
                                                    LostKeyboardFocus="HotkeyTextBox_LostFocus"
                                                    PreviewKeyDown="HotkeyTextBox_KeyDown"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='{}{0} hotkey'}" />
                                                <controls:HdrPillToggle
                                                    Grid.Column="3"
                                                    Margin="12,0,0,0"
                                                    IsChecked="{Binding IsHdrEnabled, Mode=OneWay}"
                                                    IsEnabled="{Binding CanSelect, Mode=OneWay}"
                                                    Toggled="MonitorHdrToggle_Toggled"
                                                    AutomationProperties.Name="{Binding Name}"
                                                    AutomationProperties.HelpText="{Binding StatusLabel}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding EmptyStateVisibility}">
                                <ProgressBar
                                    Width="80"
                                    Margin="0,0,0,6"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsRefreshing, Converter={StaticResource VisibleWhenTrue}}" />
                                <TextBlock
                                    Style="{StaticResource IconStyle}"
                                    Text="&#xE7F4;"
                                    FontSize="20"
                                    Foreground="{DynamicResource DashboardMutedBrush}"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    Text="No active displays found"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource DashboardTextBrush}" />
                                <TextBlock
                                    Text="Connect a display, then refresh."
                                    FontSize="11"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource DashboardMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="1" Visibility="{Binding SettingsPageVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Text="General"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Margin="5,0,5,12"
                        Foreground="{DynamicResource DashboardMutedBrush}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,2,5">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="Dark mode" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock Text="Switch between a light and a dark look." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Click="ThemeToggle_Click"
                                        Width="36"
                                        Height="32"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        ToolTip="{Binding ThemeToggleName}"
                                        AutomationProperties.Name="{Binding ThemeToggleName}">
                                        <TextBlock Style="{StaticResource IconStyle}" Text="{Binding ThemeGlyph}" FontSize="15" HorizontalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="Keep in the system tray" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock Text="Closing the window sends the app to the tray." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox
                                        Grid.Column="1"
                                        IsChecked="{Binding KeepInSystemTrayOnClose, Mode=OneWay}"
                                        MinWidth="0"
                                        Checked="TrayOption_Changed"
                                        Unchecked="TrayOption_Changed"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Keep in the system tray when closing" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="Start with Windows" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock Text="Launch HDR Control when you sign in to Windows." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox
                                        Grid.Column="1"
                                        IsChecked="{Binding StartWithWindows, Mode=OneWay}"
                                        IsEnabled="{Binding CanConfigureAutoStart}"
                                        MinWidth="0"
                                        Checked="AutoStartOption_Changed"
                                        Unchecked="AutoStartOption_Changed"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Start HDR Control with Windows" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="Start minimized in the system tray" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock Text="Stay hidden when Windows starts the app." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox
                                        Grid.Column="1"
                                        IsChecked="{Binding StartMinimizedToTray, Mode=OneWay}"
                                        IsEnabled="{Binding CanConfigureStartMinimized}"
                                        MinWidth="0"
                                        Checked="StartMinimizedOption_Changed"
                                        Unchecked="StartMinimizedOption_Changed"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Start minimized in the system tray when Windows starts HDR Control" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="Reset hotkeys" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock Text="Restore the default hotkey for every display." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Content="Reset"
                                        Click="ResetHotkeys_Click"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Reset all hotkeys" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                        <TextBlock Text="Exception log" Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock
                                            Text="Errors and crashes are written to ExceptionLog.txt in the Logs folder. Attach it when you report a problem."
                                            Style="{StaticResource MutedTextStyle}"
                                            Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Content="Open folder"
                                        Click="OpenLogFolder_Click"
                                        VerticalAlignment="Center"
                                        ToolTip="{x:Static services:ExceptionLog.LogDirectory}"
                                        AutomationProperties.Name="Open exception log folder" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Visibility="{Binding NotificationVisibility}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    MaxWidth="420"
                    Margin="0,0,0,12"
                    Padding="14,10,8,10"
                    CornerRadius="12"
                    Background="{DynamicResource DashboardToastBrush}"
                    BorderBrush="{DynamicResource DashboardCardBorderBrush}"
                    BorderThickness="1"
                    AutomationProperties.LiveSetting="Polite">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{StaticResource IconStyle}"
                            Text="{Binding NotificationGlyph}"
                            FontSize="16"
                            Foreground="{Binding NotificationIconBrush}"
                            VerticalAlignment="Top"
                            Margin="0,2,10,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding NotificationTitle}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource DashboardTextBrush}" />
                            <TextBlock
                                Text="{Binding NotificationMessage}"
                                FontSize="12"
                                Margin="0,1,0,0"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource DashboardMutedBrush}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Click="NotificationClose_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6"
                            Margin="10,0,0,0"
                            MinWidth="0"
                            MinHeight="0"
                            VerticalAlignment="Top"
                            ToolTip="Dismiss"
                            AutomationProperties.Name="Dismiss notification">
                            <TextBlock Style="{StaticResource IconStyle}" Text="&#xE711;" FontSize="10" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- In-window dialog; WPF has no dialog with freely named buttons. -->
        <Grid x:Name="DialogOverlay" Visibility="Collapsed" Background="{DynamicResource DashboardOverlayBrush}">
            <Border
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24,20"
                CornerRadius="12"
                Background="{DynamicResource DashboardToastBrush}"
                BorderBrush="{DynamicResource DashboardCardBorderBrush}"
                BorderThickness="1"
                KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Cycle">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.22" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource DashboardTextBrush}" />
                    <TextBlock x:Name="DialogMessage" Margin="0,10,0,20" Style="{StaticResource MutedTextStyle}" FontSize="13" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DialogPrimaryButton" Click="DialogButton_Click" Margin="0,0,8,0" MinWidth="90" />
                        <Button x:Name="DialogSecondaryButton" Click="DialogButton_Click" Margin="0,0,8,0" MinWidth="90" />
                        <Button x:Name="DialogCloseButton" Click="DialogButton_Click" MinWidth="90" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
