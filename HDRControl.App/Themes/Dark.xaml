    <SolidColorBrush x:Key="DashboardSidebarBrush" Color="#FF2A2A2C" />
    <SolidColorBrush x:Key="DashboardCardBrush" Color="#FF2C2C2E" />
    <SolidColorBrush x:Key="DashboardCardBorderBrush" Color="#FF3A3A3C" />
    <SolidColorBrush x:Key="DashboardGlassBorderBrush" Color="#FF333336" />
    <SolidColorBrush x:Key="DashboardTextBrush" Color="#FFF2F2F2" />
