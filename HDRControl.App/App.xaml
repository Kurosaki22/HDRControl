<Application
    x:Class="HDRControl.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="DashboardBackgroundBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="DashboardSidebarBrush" Color="#99E9EAED" />
                    <SolidColorBrush x:Key="DashboardCardBrush" Color="#A6FBFCFE" />
                    <SolidColorBrush x:Key="DashboardCardBorderBrush" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="DashboardMutedBrush" Color="#686A70" />
                    <SolidColorBrush x:Key="DashboardAccentBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="DashboardAccentSoftBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="DashboardNavigationSelectedBrush" Color="#D92674E8" />
                    <SolidColorBrush x:Key="DashboardNavigationSelectedTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="DashboardNavigationTextBrush" Color="#FF33363A" />
                    <SolidColorBrush x:Key="DashboardGlassBorderBrush" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="DashboardSuccessBrush" Color="#248A5A" />
                    <SolidColorBrush x:Key="DashboardSuccessSoftBrush" Color="#E5F4EB" />
                    <SolidColorBrush x:Key="DashboardShortcutBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="DashboardShortcutBorderBrush" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="DashboardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DashboardCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DashboardCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DashboardMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DashboardAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="DashboardAccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DashboardSidebarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DashboardNavigationSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="DashboardNavigationSelectedTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="DashboardNavigationTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DashboardGlassBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DashboardSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DashboardSuccessSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DashboardShortcutBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DashboardShortcutBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="ShortcutBoxStyle" TargetType="TextBox">
                <Setter Property="Width" Value="118" />
                <Setter Property="MinHeight" Value="0" />
                <!-- The TextBox template ignores VerticalContentAlignment and sets text high, so the top padding centers it. -->
                <Setter Property="Padding" Value="8,7,8,1" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource DashboardShortcutBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DashboardShortcutBorderBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
